# Copy to .env and fill in. deploy/setup-vps.sh writes this for you on the VPS.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Set to 1 once the site is on HTTPS (cookies become Secure-only)
HTTPS_ONLY=1

# Random string, at least 32 characters:  openssl rand -hex 32
SESSION_SECRET=

# First admin account — used only the very first time the app starts.
# The admin is asked to choose a new password after signing in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Where the SQLite database and uploaded files live (relative to the app folder)
DATA_DIR=data
UPLOAD_DIR=uploads
